# Copy to .env.local before building; values are compiled into public static files.
NEXT_PUBLIC_SITE_NAME=Convertio
NEXT_PUBLIC_SITE_TAGLINE=Free file conversion and compression, processed in your browser.
NEXT_PUBLIC_SITE_URL=https://convertio.si
NEXT_PUBLIC_SUPPORT_EMAIL=hello@convertio.si
NEXT_PUBLIC_MAX_INPUT_MB=1024
NEXT_PUBLIC_MAX_IMAGE_MB=64
NEXT_PUBLIC_MAX_PDF_MB=200
NEXT_PUBLIC_MAX_MEDIA_MB=200
NEXT_PUBLIC_MAX_FILES=20
NEXT_PUBLIC_MEDIA_TIMEOUT_MIN=30
NEXT_PUBLIC_ENABLE_MEDIA_TOOLS=1
# Do not set NEXT_PUBLIC_STATIC_EXPORT=0 for a static hosting package.
