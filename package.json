{
  "name": "convertflow",
  "version": "0.1.0",
  "private": true,
  "description": "ConvertFlow - free in-browser file conversion and compression tools.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vendor:wasm": "node scripts/vendor-wasm.mjs",
    "postinstall": "node scripts/vendor-wasm.mjs",
    "postbuild": "node scripts/smoke-export.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "clsx": "2.1.1",
    "fflate": "0.8.2",
    "lucide-react": "0.545.0",
    "next": "16.4.5",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.9",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "eslint": "9.37.0",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
